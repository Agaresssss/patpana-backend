{
  "kind": "singleType",
  "collectionName": "footers",
  "info": {
    "singularName": "footer",
    "pluralName": "footers",
    "displayName": "Footer",
    "description": "Site footer: company info, social and legal links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "companyName": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "tel": {
      "type": "string"
    },
    "fax": {
      "type": "string"
    },
    "socialLinks": {
      "type": "component",
      "component": "footer.social-link",
      "repeatable": true
    },
    "copyrightText": {
      "type": "string"
    },
    "legalLinks": {
      "type": "component",
      "component": "footer.legal-link",
      "repeatable": true
    },
    "bgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
